          <ui:InvokeCode ContinueOnError="{x:Null}" Code="If in_dtTriggersInput IsNot Nothing Then&#xD;&#xA;    For Each row As DataRow In in_dtTriggersInput.Rows&#xD;&#xA;        ' Read new column names from simplified Excel (Korean)&#xD;&#xA;        Dim companyName As String = If(row.Table.Columns.Contains(&quot;회사명&quot;), row(&quot;회사명&quot;).ToString().Trim(), &quot;&quot;)&#xD;&#xA;        If String.IsNullOrWhiteSpace(companyName) Then Continue For&#xD;&#xA;        Dim tName As String = companyName &amp; &quot;_보유계약&quot;&#xD;&#xA;&#xD;&#xA;        ' Clean company name for process name creation if it contains 'Request' or '요청'&#xD;&#xA;        Dim cleanCompanyName As String = companyName&#xD;&#xA;        If companyName.Contains(&quot;Request&quot;) OrElse companyName.Contains(&quot;요청&quot;) Then&#xD;&#xA;            ' Use Regex to remove 'Request' and '요청' along with optional preceding underscores or spaces (case-insensitive)&#xD;&#xA;            cleanCompanyName = System.Text.RegularExpressions.Regex.Replace(companyName, &quot;[_\s]*(Request|요청)&quot;, &quot;&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim()&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        Dim pName As String = cleanCompanyName &amp; &quot;_보유계약&quot;&#xD;&#xA;        Dim domStr As String = If(row.Table.Columns.Contains(&quot;지정 날짜&quot;), row(&quot;지정 날짜&quot;).ToString().Trim(), &quot;&quot;)&#xD;&#xA;        Dim startTimeStr As String = If(row.Table.Columns.Contains(&quot;실행 시작 시간&quot;), row(&quot;실행 시작 시간&quot;).ToString().Trim(), &quot;&quot;)&#xD;&#xA;&#xD;&#xA;        Try&#xD;&#xA;            Dim orchestratorUrl As String = String.Format(&quot;https://cloud.uipath.com/{0}/{1}/orchestrator_&quot;, in_OrganizationName, in_TenantName)&#xD;&#xA;            &#xD;&#xA;            ' a. Verify Process Exists&#xD;&#xA;            Dim releaseId As Long = 0&#xD;&#xA;            If Not String.IsNullOrEmpty(in_AccessToken) Then&#xD;&#xA;                Using releaseClient As New System.Net.Http.HttpClient()&#xD;&#xA;                    releaseClient.DefaultRequestHeaders.Authorization = New System.Net.Http.Headers.AuthenticationHeaderValue(&quot;Bearer&quot;, in_AccessToken)&#xD;&#xA;                    If Not String.IsNullOrEmpty(in_FolderId) Then&#xD;&#xA;                        releaseClient.DefaultRequestHeaders.Add(&quot;X-UIPATH-OrganizationUnitId&quot;, in_FolderId)&#xD;&#xA;                    End If&#xD;&#xA;                    Dim releaseUrl As String = String.Format(&quot;{0}/odata/Releases?$filter=ProcessKey eq '{1}' or Name eq '{1}'&quot;, orchestratorUrl, pName)&#xD;&#xA;                    Dim relResponse As System.Net.Http.HttpResponseMessage = releaseClient.GetAsync(releaseUrl).Result&#xD;&#xA;                    If relResponse.IsSuccessStatusCode Then&#xD;&#xA;                        Dim relJson As String = relResponse.Content.ReadAsStringAsync().Result&#xD;&#xA;                        Dim regexId As New System.Text.RegularExpressions.Regex(&quot;&quot;&quot;Id&quot;&quot;\s*:\s*(\d+)&quot;)&#xD;&#xA;                        Dim match As System.Text.RegularExpressions.Match = regexId.Match(relJson)&#xD;&#xA;                        If match.Success Then&#xD;&#xA;                            Long.TryParse(match.Groups(1).Value, releaseId)&#xD;&#xA;                        End If&#xD;&#xA;                    End If&#xD;&#xA;                End Using&#xD;&#xA;            End If&#xD;&#xA;&#xD;&#xA;            If releaseId = 0 Then Throw New Exception(&quot;Process '&quot; &amp; pName &amp; &quot;' not found.&quot;)&#xD;&#xA;&#xD;&#xA;            ' b. Check if Trigger already exists by Name&#xD;&#xA;            Dim existingId As Long = 0&#xD;&#xA;            If Not String.IsNullOrEmpty(in_AccessToken) Then&#xD;&#xA;                Using checkClient As New System.Net.Http.HttpClient()&#xD;&#xA;                    checkClient.DefaultRequestHeaders.Authorization = New System.Net.Http.Headers.AuthenticationHeaderValue(&quot;Bearer&quot;, in_AccessToken)&#xD;&#xA;                    If Not String.IsNullOrEmpty(in_FolderId) Then&#xD;&#xA;                        checkClient.DefaultRequestHeaders.Add(&quot;X-UIPATH-OrganizationUnitId&quot;, in_FolderId)&#xD;&#xA;                    End If&#xD;&#xA;                    ' Filter by Name to get existing Trigger ID&#xD;&#xA;                    Dim checkUrl As String = String.Format(&quot;{0}/odata/ProcessSchedules?$filter=Name eq '{1}'&amp;$select=Id&quot;, orchestratorUrl, tName)&#xD;&#xA;                    Dim checkResponse As System.Net.Http.HttpResponseMessage = checkClient.GetAsync(checkUrl).Result&#xD;&#xA;                    If checkResponse.IsSuccessStatusCode Then&#xD;&#xA;                        Dim checkJson As String = checkResponse.Content.ReadAsStringAsync().Result&#xD;&#xA;                        Dim regexCheck As New System.Text.RegularExpressions.Regex(&quot;&quot;&quot;Id&quot;&quot;\s*:\s*(\d+)&quot;)&#xD;&#xA;                        Dim matchCheck As System.Text.RegularExpressions.Match = regexCheck.Match(checkJson)&#xD;&#xA;                        If matchCheck.Success Then&#xD;&#xA;                            Long.TryParse(matchCheck.Groups(1).Value, existingId)&#xD;&#xA;                        End If&#xD;&#xA;                    End If&#xD;&#xA;                End Using&#xD;&#xA;            End If&#xD;&#xA;&#xD;&#xA;            ' c. Parse Time&#xD;&#xA;            Dim parsedTime As DateTime&#xD;&#xA;            Dim hours, minutes As Integer&#xD;&#xA;            If DateTime.TryParse(startTimeStr, parsedTime) Then&#xD;&#xA;                hours = parsedTime.Hour&#xD;&#xA;                minutes = parsedTime.Minute&#xD;&#xA;            Else&#xD;&#xA;                Dim parts As String() = startTimeStr.Split(&quot;:&quot;c)&#xD;&#xA;                hours = CInt(parts(0))&#xD;&#xA;                minutes = CInt(parts(1))&#xD;&#xA;            End If&#xD;&#xA;&#xD;&#xA;            ' d. Cron&#xD;&#xA;            Dim domParts As String() = domStr.Split(New Char() {&quot;,&quot;c, &quot; &quot;c}, StringSplitOptions.RemoveEmptyEntries)&#xD;&#xA;            Dim cleanedDom As String = String.Join(&quot;,&quot;, domParts)&#xD;&#xA;            If String.IsNullOrWhiteSpace(cleanedDom) Then cleanedDom = &quot;*&quot;&#xD;&#xA;            Dim cron As String = String.Format(&quot;0 {0} {1} {2} * ?&quot;, minutes, hours, cleanedDom)&#xD;&#xA;&#xD;&#xA;            ' e. API Call (Upsert)&#xD;&#xA;            If Not String.IsNullOrEmpty(in_AccessToken) Then&#xD;&#xA;                Using client As New System.Net.Http.HttpClient()&#xD;&#xA;                    client.DefaultRequestHeaders.Authorization = New System.Net.Http.Headers.AuthenticationHeaderValue(&quot;Bearer&quot;, in_AccessToken)&#xD;&#xA;                    If Not String.IsNullOrEmpty(in_FolderId) Then&#xD;&#xA;                        client.DefaultRequestHeaders.Add(&quot;X-UIPATH-OrganizationUnitId&quot;, in_FolderId)&#xD;&#xA;                    End If&#xD;&#xA;                    &#xD;&#xA;                    Dim q As String = Chr(34)&#xD;&#xA;                    ' Advanced metadata is fine&#xD;&#xA;                    Dim details As String = &quot;{}&quot;&#xD;&#xA;                    &#xD;&#xA;                    ' Parse optional AccountId and MachineId&#xD;&#xA;                    Dim robotIdVal As Nullable(Of Long) = Nothing&#xD;&#xA;                    Dim machineIdVal As Nullable(Of Long) = Nothing&#xD;&#xA;                    Dim tmpId As Long&#xD;&#xA;                    If Not String.IsNullOrWhiteSpace(in_AccountId) AndAlso Long.TryParse(in_AccountId.Trim(), tmpId) Then&#xD;&#xA;                        robotIdVal = tmpId&#xD;&#xA;                    End If&#xD;&#xA;                    If Not String.IsNullOrWhiteSpace(in_MachineId) AndAlso Long.TryParse(in_MachineId.Trim(), tmpId) Then&#xD;&#xA;                        machineIdVal = tmpId&#xD;&#xA;                    End If&#xD;&#xA;&#xD;&#xA;                    Dim machineRobotsPart As String = &quot;&quot;&#xD;&#xA;                    If robotIdVal.HasValue OrElse machineIdVal.HasValue Then&#xD;&#xA;                        Dim rIdStr As String = If(robotIdVal.HasValue, robotIdVal.Value.ToString(), &quot;null&quot;)&#xD;&#xA;                        Dim mIdStr As String = If(machineIdVal.HasValue, machineIdVal.Value.ToString(), &quot;null&quot;)&#xD;&#xA;                        machineRobotsPart = &quot;,&quot; &amp; q &amp; &quot;MachineRobots&quot; &amp; q &amp; &quot;:[{&quot; &amp; q &amp; &quot;RobotId&quot; &amp; q &amp; &quot;:&quot; &amp; rIdStr &amp; &quot;,&quot; &amp; q &amp; &quot;MachineId&quot; &amp; q &amp; &quot;:&quot; &amp; mIdStr &amp; &quot;}]&quot;&#xD;&#xA;                    End If&#xD;&#xA;&#xD;&#xA;                    ' Payload base&#xD;&#xA;                    Dim payloadBase As String = q &amp; &quot;Name&quot; &amp; q &amp; &quot;:&quot; &amp; q &amp; tName &amp; q &amp; &quot;,&quot; &amp; q &amp; &quot;ReleaseId&quot; &amp; q &amp; &quot;:&quot; &amp; releaseId &amp; &quot;,&quot; &amp; q &amp; &quot;StartStrategy&quot; &amp; q &amp; &quot;:1,&quot; &amp; q &amp; &quot;StartProcessCron&quot; &amp; q &amp; &quot;:&quot; &amp; q &amp; cron &amp; q &amp; &quot;,&quot; &amp; q &amp; &quot;StartProcessCronDetails&quot; &amp; q &amp; &quot;:&quot; &amp; q &amp; details &amp; q &amp; &quot;,&quot; &amp; q &amp; &quot;TimeZoneId&quot; &amp; q &amp; &quot;:&quot; &amp; q &amp; &quot;Korea Standard Time&quot; &amp; q &amp; &quot;,&quot; &amp; q &amp; &quot;Enabled&quot; &amp; q &amp; &quot;:true&quot; &amp; machineRobotsPart&#xD;&#xA;                    &#xD;&#xA;                    Dim response As System.Net.Http.HttpResponseMessage&#xD;&#xA;                    If existingId &gt; 0 Then&#xD;&#xA;                        ' PUT to update&#xD;&#xA;                        Dim triggerId As Long = existingId&#xD;&#xA;                        Dim putUrl As String = String.Format(&quot;{0}/odata/ProcessSchedules({1})&quot;, orchestratorUrl, triggerId)&#xD;&#xA;                        ' Adding ID to payload for PUT&#xD;&#xA;                        Dim putPayload As String = &quot;{&quot; &amp; q &amp; &quot;Id&quot; &amp; q &amp; &quot;:&quot; &amp; triggerId &amp; &quot;,&quot; &amp; payloadBase &amp; &quot;}&quot;&#xD;&#xA;                        Dim putContent As New System.Net.Http.StringContent(putPayload, System.Text.Encoding.UTF8)&#xD;&#xA;                        putContent.Headers.ContentType = New System.Net.Http.Headers.MediaTypeHeaderValue(&quot;application/json&quot;)&#xD;&#xA;                        response = client.PutAsync(putUrl, putContent).Result&#xD;&#xA;                    Else&#xD;&#xA;                        ' POST to create&#xD;&#xA;                        Dim postUrl As String = orchestratorUrl &amp; &quot;/odata/ProcessSchedules&quot;&#xD;&#xA;                        Dim postPayload As String = &quot;{&quot; &amp; payloadBase &amp; &quot;}&quot;&#xD;&#xA;                        Dim postContent As New System.Net.Http.StringContent(postPayload, System.Text.Encoding.UTF8)&#xD;&#xA;                        postContent.Headers.ContentType = New System.Net.Http.Headers.MediaTypeHeaderValue(&quot;application/json&quot;)&#xD;&#xA;                        response = client.PostAsync(postUrl, postContent).Result&#xD;&#xA;                    End If&#xD;&#xA;&#xD;&#xA;                    If Not response.IsSuccessStatusCode Then&#xD;&#xA;                        Throw New Exception(&quot;API Error: &quot; &amp; response.Content.ReadAsStringAsync().Result)&#xD;&#xA;                    End If&#xD;&#xA;                End Using&#xD;&#xA;            End If&#xD;&#xA;&#xD;&#xA;            io_dtReport.Rows.Add(tName, &quot;Success&quot;, &quot;Cron: &quot; &amp; cron)&#xD;&#xA;        Catch ex As Exception&#xD;&#xA;            io_dtReport.Rows.Add(tName, &quot;Failed&quot;, ex.Message)&#xD;&#xA;        End Try&#xD;&#xA;    Next&#xD;&#xA;End If" DisplayName="Invoke Code: Process Rows" sap:Virtua