    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ====== Input variables: outputDir, runId ======&#xA;Dim jsonPath  As String = System.IO.Path.Combine(outputDir, &quot;result_&quot; &amp; runId &amp; &quot;.json&quot;)&#xA;Dim excelPath As String = System.IO.Path.Combine(outputDir, &quot;Report_&quot; &amp; runId &amp; &quot;.xlsx&quot;)&#xA;&#xA;' ====== Đọc JSON và ghi vào Excel ======&#xA;Dim jsonContent As String = System.IO.File.ReadAllText(jsonPath, System.Text.Encoding.UTF8)&#xA;Dim jsonData As Newtonsoft.Json.Linq.JArray = Newtonsoft.Json.Linq.JArray.Parse(jsonContent)&#xA;&#xA;Dim workbook As New ClosedXML.Excel.XLWorkbook(excelPath)&#xA;Dim ws As ClosedXML.Excel.IXLWorksheet = workbook.Worksheet(&quot;Result&quot;)&#xA;&#xA;' ====== Header ======&#xA;ws.Cell(1, 1).Value = &quot;No&quot;&#xA;ws.Cell(1, 2).Value = &quot;Company Code&quot;&#xA;ws.Cell(1, 3).Value = &quot;Company Name&quot;&#xA;ws.Cell(1, 4).Value = &quot;Login Status&quot;&#xA;ws.Cell(1, 5).Value = &quot;Process Time&quot;&#xA;&#xA;' ====== Style Header ======&#xA;Dim headerRange As ClosedXML.Excel.IXLRange = ws.Range(1, 1, 1, 5)&#xA;headerRange.Style.Font.Bold = True&#xA;headerRange.Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Center&#xA;headerRange.Style.Border.OutsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin&#xA;headerRange.Style.Border.InsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin&#xA;&#xA;' ====== Ghi Data ======&#xA;Dim rowIndex As Integer = 2&#xA;For Each item As Newtonsoft.Json.Linq.JObject In jsonData&#xA;    Dim compCode    As String = item(&quot;compCode&quot;).ToString()&#xA;    Dim companyName As String = item(&quot;companyName&quot;).ToString()&#xA;    Dim isLogined   As String = item(&quot;isLogined&quot;).ToString()&#xA;    Dim processTime As String = item(&quot;processTime&quot;).ToString()&#xA;&#xA;    ws.Cell(rowIndex, 1).Value = rowIndex - 1&#xA;    ws.Cell(rowIndex, 1).Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Center&#xA;&#xA;    ws.Cell(rowIndex, 2).Value = compCode&#xA;    ws.Cell(rowIndex, 2).Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Center&#xA;&#xA;    ws.Cell(rowIndex, 3).Value = companyName&#xA;&#xA;    ws.Cell(rowIndex, 4).Value = If(isLogined = &quot;Y&quot;, &quot;Y&quot;, If(isLogined = &quot;N&quot;, &quot;N&quot;, &quot;&quot;))&#xA;    ws.Cell(rowIndex, 4).Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Center&#xA;&#xA;    ws.Cell(rowIndex, 5).Value = If(String.IsNullOrEmpty(processTime), &quot;&quot;, processTime)&#xA;    ws.Cell(rowIndex, 5).Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Center&#xA;&#xA;    Dim dataRange As ClosedXML.Excel.IXLRange = ws.Range(rowIndex, 1, rowIndex, 5)&#xA;    dataRange.Style.Border.OutsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin&#xA;    dataRange.Style.Border.InsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin&#xA;&#xA;    rowIndex += 1&#xA;Next&#xA;&#xA;' ====== Auto-fit + Freeze ======&#xA;ws.Columns().AdjustToContents()&#xA;ws.SheetView.FreezeRows(1)&#xA;&#xA;' ====== Lưu file ======&#xA;workbook.Save()&#xA;workbook.Dispose()" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="449.6,188" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
