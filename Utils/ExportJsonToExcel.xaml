    <Delay Duration="00:00:05" sap:VirtualizedContainerService.HintSize="449.6,122.4" sap2010:WorkflowViewState.IdRef="Delay_1" />
    <WriteLine DisplayName="Write Line" sap:VirtualizedContainerService.HintSize="449.6,122.4" sap2010:WorkflowViewState.IdRef="WriteLine_1" Text="[&quot;CHECKING ID &quot; + CHECKING_ID]" />
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ====== Input variables: outputDir, runId ======&#xD;&#xA;Dim jsonPath  As String = System.IO.Path.Combine(outputDir, &quot;result_&quot; &amp; runId &amp; &quot;.json&quot;)&#xD;&#xA;Dim excelPath As String = System.IO.Path.Combine(outputDir, &quot;Report_&quot; &amp; runId &amp; &quot;.xlsx&quot;)&#xD;&#xA;&#xD;&#xA;' ====== Read JSON file ======&#xD;&#xA;Dim jsonContent As String = System.IO.File.ReadAllText(jsonPath, System.Text.Encoding.UTF8)&#xD;&#xA;Dim jsonData As Newtonsoft.Json.Linq.JArray = Newtonsoft.Json.Linq.JArray.Parse(jsonContent)&#xD;&#xA;&#xD;&#xA;' ====== Open existing Excel file (header + border already initialized) ======&#xD;&#xA;Dim workbook As New ClosedXML.Excel.XLWorkbook(excelPath)&#xD;&#xA;Dim ws As ClosedXML.Excel.IXLWorksheet = workbook.Worksheet(&quot;Result&quot;)&#xD;&#xA;&#xD;&#xA;' ====== Write data starting from row 2 ======&#xD;&#xA;Dim rowIndex As Integer = 2&#xD;&#xA;For Each item As Newtonsoft.Json.Linq.JObject In jsonData&#xD;&#xA;    Dim companyName As String = item(&quot;companyName&quot;).ToString()&#xD;&#xA;    Dim isLogined   As String = item(&quot;isLogined&quot;).ToString()&#xD;&#xA;    Dim processTime As String = item(&quot;processTime&quot;).ToString()&#xD;&#xA;&#xD;&#xA;    ' -- Column A: No --&#xD;&#xA;    ws.Cell(rowIndex, 1).Value = rowIndex - 1&#xD;&#xA;&#xD;&#xA;    ' -- Column B: Company name --&#xD;&#xA;    ws.Cell(rowIndex, 2).Value = companyName&#xD;&#xA;&#xD;&#xA;    ' -- Column C: Status --&#xD;&#xA;    ' &quot;Y&quot;  → &quot;성공&quot; (black)&#xD;&#xA;    ' &quot;N&quot;  → &quot;실패&quot; (red)&#xD;&#xA;    ' &quot;&quot;   → leave blank, do nothing&#xD;&#xA;    If isLogined = &quot;Y&quot; Then&#xD;&#xA;        ws.Cell(rowIndex, 3).Value = &quot;성공&quot;&#xD;&#xA;        ws.Cell(rowIndex, 3).Style.Font.FontColor = ClosedXML.Excel.XLColor.Black&#xD;&#xA;    ElseIf isLogined = &quot;N&quot; Then&#xD;&#xA;        ws.Cell(rowIndex, 3).Value = &quot;실패&quot;&#xD;&#xA;        ws.Cell(rowIndex, 3).Style.Font.FontColor = ClosedXML.Excel.XLColor.Red&#xD;&#xA;    ' isLogined is empty → do nothing, leave cell blank&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    ' -- Column D: Confirmed datetime → format yyyy-MM-dd HH:mm:ss --&#xD;&#xA;    If Not String.IsNullOrEmpty(processTime) Then&#xD;&#xA;        Dim parsedTime As DateTime&#xD;&#xA;        If DateTime.TryParse(processTime, parsedTime) Then&#xD;&#xA;            ws.Cell(rowIndex, 4).Value = parsedTime.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;)&#xD;&#xA;        Else&#xD;&#xA;            ws.Cell(rowIndex, 4).Value = processTime&#xD;&#xA;        End If&#xD;&#xA;    Else&#xD;&#xA;        ws.Cell(rowIndex, 4).Value = &quot;&quot;&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    rowIndex += 1&#xD;&#xA;Next&#xD;&#xA;&#xD;&#xA;' ====== Save and dispose workbook ======&#xD;&#xA;workbook.Save()&#xD;&#xA;workbook.Dispose()" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="449.6,188" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
