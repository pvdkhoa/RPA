    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ====== Input variables: outputDir, runId ======&#xD;&#xA;Dim jsonPath  As String = System.IO.Path.Combine(outputDir, &quot;result_&quot; &amp; runId &amp; &quot;.json&quot;)&#xD;&#xA;Dim excelPath As String = System.IO.Path.Combine(outputDir, &quot;Report_&quot; &amp; runId &amp; &quot;.xlsx&quot;)&#xD;&#xA;&#xD;&#xA;' ====== Đọc JSON và ghi vào Excel ======&#xD;&#xA;Dim jsonContent As String = System.IO.File.ReadAllText(jsonPath, System.Text.Encoding.UTF8)&#xD;&#xA;Dim jsonData As Newtonsoft.Json.Linq.JArray = Newtonsoft.Json.Linq.JArray.Parse(jsonContent)&#xD;&#xA;&#xD;&#xA;Dim workbook As New ClosedXML.Excel.XLWorkbook(excelPath)&#xD;&#xA;Dim ws As ClosedXML.Excel.IXLWorksheet = workbook.Worksheet(&quot;Result&quot;)&#xD;&#xA;&#xD;&#xA;' ====== Header ======&#xD;&#xA;ws.Cell(1, 1).Value = &quot;No&quot;&#xD;&#xA;ws.Cell(1, 2).Value = &quot;Company Code&quot;&#xD;&#xA;ws.Cell(1, 3).Value = &quot;Company Name&quot;&#xD;&#xA;ws.Cell(1, 4).Value = &quot;Login Status&quot;&#xD;&#xA;ws.Cell(1, 5).Value = &quot;Process Time&quot;&#xD;&#xA;&#xD;&#xA;' ====== Style Header ======&#xD;&#xA;Dim headerRange As ClosedXML.Excel.IXLRange = ws.Range(1, 1, 1, 5)&#xD;&#xA;headerRange.Style.Font.Bold = True&#xD;&#xA;headerRange.Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Center&#xD;&#xA;headerRange.Style.Border.OutsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin&#xD;&#xA;headerRange.Style.Border.InsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin&#xD;&#xA;&#xD;&#xA;' ====== Ghi Data ======&#xD;&#xA;Dim rowIndex As Integer = 2&#xD;&#xA;For Each item As Newtonsoft.Json.Linq.JObject In jsonData&#xD;&#xA;    Dim compCode    As String = item(&quot;compCode&quot;).ToString()&#xD;&#xA;    Dim companyName As String = item(&quot;companyName&quot;).ToString()&#xD;&#xA;    Dim isLogined   As String = item(&quot;isLogined&quot;).ToString()&#xD;&#xA;    Dim processTime As String = item(&quot;processTime&quot;).ToString()&#xD;&#xA;&#xD;&#xA;    ws.Cell(rowIndex, 1).Value = rowIndex - 1&#xD;&#xA;    ws.Cell(rowIndex, 1).Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Center&#xD;&#xA;&#xD;&#xA;    ws.Cell(rowIndex, 2).Value = compCode&#xD;&#xA;    ws.Cell(rowIndex, 2).Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Center&#xD;&#xA;&#xD;&#xA;    ws.Cell(rowIndex, 3).Value = companyName&#xD;&#xA;&#xD;&#xA;    ws.Cell(rowIndex, 4).Value = If(isLogined = &quot;Y&quot;, &quot;Y&quot;, If(isLogined = &quot;N&quot;, &quot;N&quot;, &quot;&quot;))&#xD;&#xA;    ws.Cell(rowIndex, 4).Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Center&#xD;&#xA;&#xD;&#xA;    ws.Cell(rowIndex, 5).Value = If(String.IsNullOrEmpty(processTime), &quot;&quot;, processTime)&#xD;&#xA;    ws.Cell(rowIndex, 5).Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Center&#xD;&#xA;&#xD;&#xA;    Dim dataRange As ClosedXML.Excel.IXLRange = ws.Range(rowIndex, 1, rowIndex, 5)&#xD;&#xA;    dataRange.Style.Border.OutsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin&#xD;&#xA;    dataRange.Style.Border.InsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin&#xD;&#xA;&#xD;&#xA;    rowIndex += 1&#xD;&#xA;Next&#xD;&#xA;&#xD;&#xA;' ====== Auto-fit + Freeze ======&#xD;&#xA;ws.Columns().AdjustToContents()&#xD;&#xA;ws.SheetView.FreezeRows(1)&#xD;&#xA;&#xD;&#xA;' ====== Lưu file ======&#xD;&#xA;workbook.Save()&#xD;&#xA;workbook.Dispose()" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="449.6,188" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
