            <ui:InvokeCode ContinueOnError="{x:Null}" Code="' 0. Fallback: Nếu in_AIUploadResult trống do Exception, đọc từ file backup&#xD;&#xA;If String.IsNullOrWhiteSpace(in_AIUploadResult) Then&#xD;&#xA;    Try&#xD;&#xA;        Dim backupPath As String = &quot;C:\RPA\AI_Upload_Result.json&quot;&#xD;&#xA;        If System.IO.File.Exists(backupPath) Then&#xD;&#xA;            Dim content As String = System.IO.File.ReadAllText(backupPath)&#xD;&#xA;            If Not String.IsNullOrWhiteSpace(content) Then&#xD;&#xA;                in_AIUploadResult = content&#xD;&#xA;            End If&#xD;&#xA;        End If&#xD;&#xA;    Catch&#xD;&#xA;    End Try&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;' Hàm lấy giá trị từ Asset Dict&#xD;&#xA;Dim getVal = Function(key As String) As String&#xD;&#xA;    If in_DictStatus IsNot Nothing AndAlso in_DictStatus.ContainsKey(key) Then&#xD;&#xA;        Return in_DictStatus(key).ToString().Trim().ToUpper()&#xD;&#xA;    End If&#xD;&#xA;    Return &quot;-&quot;&#xD;&#xA;End Function&#xD;&#xA;&#xD;&#xA;' 1. HÀM ĐỊNH DẠNG THEO ĐÚNG SPEC REQUIREMENT&#xD;&#xA;' Cột 조회결과: &quot;데이터 있음&quot; hoặc &quot;데이터 없음&quot;&#xD;&#xA;Dim formatSearch = Function(sVal As String, dVal As String) As String&#xD;&#xA;    If sVal = &quot;Y&quot; Then&#xD;&#xA;        Return &quot;데이터 있음&quot;&#xD;&#xA;    Else&#xD;&#xA;        ' Nếu sVal là &quot;N&quot;, &quot;S&quot;, &quot;E&quot;, &quot;-&quot; nhưng dVal là &quot;S&quot; hoặc không có data =&gt; &quot;데이터 없음&quot;&#xD;&#xA;        Return &quot;데이터 없음&quot;&#xD;&#xA;    End If&#xD;&#xA;End Function&#xD;&#xA;&#xD;&#xA;' Cột 다운로드, 데이터 편집, M.Post 업로드: &quot;완료&quot;, &quot;실패&quot;, &quot;생략&quot;&#xD;&#xA;Dim formatStep = Function(st As String) As String&#xD;&#xA;    If String.IsNullOrWhiteSpace(st) Then Return &quot;생략&quot;&#xD;&#xA;    Select Case st.Trim().ToUpper()&#xD;&#xA;        Case &quot;Y&quot;&#xD;&#xA;            Return &quot;완료&quot;&#xD;&#xA;        Case &quot;N&quot;&#xD;&#xA;            Return &quot;&lt;span style='color: #dc3545; font-weight: bold;'&gt;실패&lt;/span&gt;&quot;&#xD;&#xA;        Case &quot;S&quot;, &quot;E&quot;, &quot;-&quot;, &quot;SKIPPED&quot;, &quot;PENDING&quot;&#xD;&#xA;            Return &quot;-&quot;&#xD;&#xA;        Case Else&#xD;&#xA;            Return &quot;생략&quot;&#xD;&#xA;    End Select&#xD;&#xA;End Function&#xD;&#xA;&#xD;&#xA;' Cột 최종결과: &quot;성공&quot; hoặc &quot;실패&quot;&#xD;&#xA;' Quy tắc spec: Nếu 다운로드, 데이터 편집 hoặc 업로드 có lỗi thực tế (N) =&gt; 실패, ngược lại =&gt; 성공&#xD;&#xA;Dim calcFinal = Function(dVal As String, mVal As String, uVal As String) As String&#xD;&#xA;    If dVal = &quot;N&quot; OrElse mVal = &quot;N&quot; OrElse uVal = &quot;N&quot; Then&#xD;&#xA;        Return &quot;&lt;span style='color: #dc3545; font-weight: bold;'&gt;실패&lt;/span&gt;&quot;&#xD;&#xA;    Else&#xD;&#xA;        Return &quot;성공&quot;&#xD;&#xA;    End If&#xD;&#xA;End Function&#xD;&#xA;&#xD;&#xA;' Hàm map trạng thái branch từ JSON AI sang ký hiệu nội bộ (Y, N, S)&#xD;&#xA;Dim mapAiBranch = Function(st As String) As String&#xD;&#xA;    If String.IsNullOrWhiteSpace(st) Then Return &quot;S&quot;&#xD;&#xA;    Select Case st.Trim().ToLower()&#xD;&#xA;        Case &quot;success&quot;, &quot;completed&quot;&#xD;&#xA;            Return &quot;Y&quot;&#xD;&#xA;        Case &quot;failed&quot;, &quot;error&quot;&#xD;&#xA;            Return &quot;N&quot;&#xD;&#xA;        Case &quot;skipped&quot;, &quot;pending&quot;&#xD;&#xA;            Return &quot;S&quot;&#xD;&#xA;        Case Else&#xD;&#xA;            Return &quot;S&quot;&#xD;&#xA;    End Select&#xD;&#xA;End Function&#xD;&#xA;&#xD;&#xA;' 2. Khởi tạo trạng thái mặc định cho Upload AI&#xD;&#xA;Dim uploadLTR As String = &quot;S&quot;&#xD;&#xA;Dim uploadGEN As String = &quot;S&quot;&#xD;&#xA;Dim uploadCAR As String = &quot;S&quot;&#xD;&#xA;Dim hasError As Boolean = False&#xD;&#xA;Dim errorPopup As String = &quot;&quot;&#xD;&#xA;Dim aiAnalysis As String = &quot;&quot;&#xD;&#xA;Dim aiSuggestion As String = &quot;&quot;&#xD;&#xA;Dim failedBranch As String = &quot;&quot;&#xD;&#xA;Dim failedStep As String = &quot;&quot;&#xD;&#xA;&#xD;&#xA;' 3. Phân tích kết quả JSON từ AI Upload&#xD;&#xA;If Not String.IsNullOrWhiteSpace(in_AIUploadResult) Then&#xD;&#xA;    Try&#xD;&#xA;        Dim jsonObj = Newtonsoft.Json.Linq.JObject.Parse(in_AIUploadResult)&#xD;&#xA;        Dim overallStatus = If(jsonObj(&quot;status&quot;) IsNot Nothing, jsonObj(&quot;status&quot;).ToString().ToLower(), &quot;&quot;)&#xD;&#xA;        &#xD;&#xA;        If jsonObj(&quot;branches&quot;) IsNot Nothing Then&#xD;&#xA;            Dim branches = jsonObj(&quot;branches&quot;)&#xD;&#xA;            &#xD;&#xA;            ' Nhánh 장기 (Longterm)&#xD;&#xA;            If branches(&quot;ltr&quot;) IsNot Nothing AndAlso branches(&quot;ltr&quot;)(&quot;status&quot;) IsNot Nothing Then&#xD;&#xA;                uploadLTR = mapAiBranch(branches(&quot;ltr&quot;)(&quot;status&quot;).ToString())&#xD;&#xA;            ElseIf branches(&quot;long_term&quot;) IsNot Nothing AndAlso branches(&quot;long_term&quot;)(&quot;status&quot;) IsNot Nothing Then&#xD;&#xA;                uploadLTR = mapAiBranch(branches(&quot;long_term&quot;)(&quot;status&quot;).ToString())&#xD;&#xA;            ElseIf branches(&quot;장기&quot;) IsNot Nothing AndAlso branches(&quot;장기&quot;)(&quot;status&quot;) IsNot Nothing Then&#xD;&#xA;                uploadLTR = mapAiBranch(branches(&quot;장기&quot;)(&quot;status&quot;).ToString())&#xD;&#xA;            End If&#xD;&#xA;            &#xD;&#xA;            ' Nhánh 일반 (General)&#xD;&#xA;            If branches(&quot;gen&quot;) IsNot Nothing AndAlso branches(&quot;gen&quot;)(&quot;status&quot;) IsNot Nothing Then&#xD;&#xA;                uploadGEN = mapAiBranch(branches(&quot;gen&quot;)(&quot;status&quot;).ToString())&#xD;&#xA;            ElseIf branches(&quot;general&quot;) IsNot Nothing AndAlso branches(&quot;general&quot;)(&quot;status&quot;) IsNot Nothing Then&#xD;&#xA;                uploadGEN = mapAiBranch(branches(&quot;general&quot;)(&quot;status&quot;).ToString())&#xD;&#xA;            ElseIf branches(&quot;일반&quot;) IsNot Nothing AndAlso branches(&quot;일반&quot;)(&quot;status&quot;) IsNot Nothing Then&#xD;&#xA;                uploadGEN = mapAiBranch(branches(&quot;일반&quot;)(&quot;status&quot;).ToString())&#xD;&#xA;            End If&#xD;&#xA;            &#xD;&#xA;            ' Nhánh 자동차 (Car / Auto)&#xD;&#xA;            If branches(&quot;car&quot;) IsNot Nothing AndAlso branches(&quot;car&quot;)(&quot;status&quot;) IsNot Nothing Then&#xD;&#xA;                uploadCAR = mapAiBranch(branches(&quot;car&quot;)(&quot;status&quot;).ToString())&#xD;&#xA;            ElseIf branches(&quot;auto&quot;) IsNot Nothing AndAlso branches(&quot;auto&quot;)(&quot;status&quot;) IsNot Nothing Then&#xD;&#xA;                uploadCAR = mapAiBranch(branches(&quot;auto&quot;)(&quot;status&quot;).ToString())&#xD;&#xA;            ElseIf branches(&quot;자동차&quot;) IsNot Nothing AndAlso branches(&quot;자동차&quot;)(&quot;status&quot;) IsNot Nothing Then&#xD;&#xA;                uploadCAR = mapAiBranch(branches(&quot;자동차&quot;)(&quot;status&quot;).ToString())&#xD;&#xA;            End If&#xD;&#xA;        Else&#xD;&#xA;            If overallStatus = &quot;completed&quot; OrElse overallStatus = &quot;success&quot; Then&#xD;&#xA;                uploadLTR = &quot;Y&quot; : uploadGEN = &quot;Y&quot; : uploadCAR = &quot;Y&quot;&#xD;&#xA;            Else&#xD;&#xA;                uploadLTR = &quot;N&quot; : uploadGEN = &quot;N&quot; : uploadCAR = &quot;N&quot;&#xD;&#xA;            End If&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        ' Đọc thông tin lỗi chi tiết&#xD;&#xA;        If overallStatus &lt;&gt; &quot;completed&quot; AndAlso overallStatus &lt;&gt; &quot;success&quot; Then&#xD;&#xA;            If jsonObj(&quot;error_info&quot;) IsNot Nothing Then&#xD;&#xA;                Dim errInfo = jsonObj(&quot;error_info&quot;)&#xD;&#xA;                failedBranch = If(errInfo(&quot;failed_branch&quot;) IsNot Nothing, errInfo(&quot;failed_branch&quot;).ToString(), &quot;&quot;)&#xD;&#xA;                failedStep = If(errInfo(&quot;failed_step&quot;) IsNot Nothing, errInfo(&quot;failed_step&quot;).ToString(), &quot;&quot;)&#xD;&#xA;                errorPopup = If(errInfo(&quot;popup_message&quot;) IsNot Nothing, errInfo(&quot;popup_message&quot;).ToString(), &quot;&quot;)&#xD;&#xA;                aiAnalysis = If(errInfo(&quot;root_cause&quot;) IsNot Nothing, errInfo(&quot;root_cause&quot;).ToString(), &quot;&quot;)&#xD;&#xA;                aiSuggestion = If(errInfo(&quot;suggestion&quot;) IsNot Nothing, errInfo(&quot;suggestion&quot;).ToString(), &quot;&quot;)&#xD;&#xA;            End If&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;    Catch ex As Exception&#xD;&#xA;        If in_AIUploadResult.ToUpper().Contains(&quot;STATUS: SUCCESS&quot;) OrElse in_AIUploadResult.ToUpper().Contains(&quot;COMPLETED&quot;) Then&#xD;&#xA;            uploadLTR = &quot;Y&quot; : uploadGEN = &quot;Y&quot; : uploadCAR = &quot;Y&quot;&#xD;&#xA;        Else&#xD;&#xA;            uploadLTR = &quot;N&quot;&#xD;&#xA;            aiAnalysis = in_AIUploadResult&#xD;&#xA;        End If&#xD;&#xA;    End Try&#xD;&#xA;Else&#xD;&#xA;    uploadLTR = &quot;N&quot;&#xD;&#xA;    aiAnalysis = &quot;AI 업로드 응답 수신 실패 (Timeout 또는 서버 오류)&quot;&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;' 4. ĐỒNG BỘ: Nếu Search không có data hoặc Download/Modify bị bỏ qua thì Upload chắc chắn là &quot;생략&quot; (S)&#xD;&#xA;Dim syncSkip = Sub(ByRef upStatus As String, sKey As String, dKey As String, mKey As String)&#xD;&#xA;    Dim sVal = getVal(sKey)&#xD;&#xA;    Dim dVal = getVal(dKey)&#xD;&#xA;    Dim mVal = getVal(mKey)&#xD;&#xA;    If sVal &lt;&gt; &quot;Y&quot; OrElse dVal = &quot;S&quot; OrElse mVal = &quot;S&quot; OrElse dVal = &quot;N&quot; OrElse mVal = &quot;N&quot; Then&#xD;&#xA;        upStatus = &quot;S&quot;&#xD;&#xA;    End If&#xD;&#xA;End Sub&#xD;&#xA;&#xD;&#xA;syncSkip(uploadLTR, &quot;SEARCH_STATUS&quot;, &quot;DOWNLOAD_STATUS&quot;, &quot;MODIFY_STATUS&quot;)&#xD;&#xA;syncSkip(uploadGEN, &quot;SEARCH_STATUS_GEN&quot;, &quot;DOWNLOAD_STATUS_GEN&quot;, &quot;MODIFY_STATUS_GEN&quot;)&#xD;&#xA;syncSkip(uploadCAR, &quot;SEARCH_STATUS_CAR&quot;, &quot;DOWNLOAD_STATUS_CAR&quot;, &quot;MODIFY_STATUS_CAR&quot;)&#xD;&#xA;&#xD;&#xA;' Chuẩn hóa tên nhánh lỗi cho khung vàng&#xD;&#xA;If Not String.IsNullOrWhiteSpace(failedBranch) Then&#xD;&#xA;    Select Case failedBranch.Trim().ToLower()&#xD;&#xA;        Case &quot;auto&quot;, &quot;car&quot;, &quot;자동차&quot;: failedBranch = &quot;자동차&quot;&#xD;&#xA;        Case &quot;ltr&quot;, &quot;long_term&quot;, &quot;longterm&quot;, &quot;장기&quot;: failedBranch = &quot;장기&quot;&#xD;&#xA;        Case &quot;gen&quot;, &quot;general&quot;, &quot;일반&quot;: failedBranch = &quot;일반&quot;&#xD;&#xA;    End Select&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;' 5. LẤY GIÁ TRỊ TỪNG NHÁNH ĐỂ TÍNH TOÁN&#xD;&#xA;Dim sLTR = getVal(&quot;SEARCH_STATUS&quot;), dLTR = getVal(&quot;DOWNLOAD_STATUS&quot;), mLTR = getVal(&quot;MODIFY_STATUS&quot;)&#xD;&#xA;Dim sGEN = getVal(&quot;SEARCH_STATUS_GEN&quot;), dGEN = getVal(&quot;DOWNLOAD_STATUS_GEN&quot;), mGEN = getVal(&quot;MODIFY_STATUS_GEN&quot;)&#xD;&#xA;Dim sCAR = getVal(&quot;SEARCH_STATUS_CAR&quot;), dCAR = getVal(&quot;DOWNLOAD_STATUS_CAR&quot;), mCAR = getVal(&quot;MODIFY_STATUS_CAR&quot;)&#xD;&#xA;&#xD;&#xA;' Tính cột 최종결과 cho từng nhánh&#xD;&#xA;Dim finalLTR = calcFinal(dLTR, mLTR, uploadLTR)&#xD;&#xA;Dim finalGEN = calcFinal(dGEN, mGEN, uploadGEN)&#xD;&#xA;Dim finalCAR = calcFinal(dCAR, mCAR, uploadCAR)&#xD;&#xA;&#xD;&#xA;' 6. ĐÁNH GIÁ TỔNG THỂ CHO TOÀN BỘ EMAIL (io_IsSuccess)&#xD;&#xA;' Chỉ khi có bất kỳ nhánh nào bị &quot;실패&quot; thực sự thì email mới coi là thất bại&#xD;&#xA;Dim multiLine = New List(Of String) From {&quot;MRF&quot;, &quot;DBG&quot;, &quot;KBG&quot;, &quot;LTG&quot;, &quot;HDG&quot;, &quot;HKF&quot;, &quot;HWG&quot;, &quot;SSF&quot;}&#xD;&#xA;If multiLine.Contains(compCode.ToUpper()) Then&#xD;&#xA;    If finalLTR.Contains(&quot;실패&quot;) OrElse finalGEN.Contains(&quot;실패&quot;) OrElse finalCAR.Contains(&quot;실패&quot;) Then&#xD;&#xA;        io_IsSuccess = &quot;False&quot;&#xD;&#xA;        hasError = True&#xD;&#xA;    Else&#xD;&#xA;        io_IsSuccess = &quot;True&quot;&#xD;&#xA;        hasError = False&#xD;&#xA;    End If&#xD;&#xA;Else&#xD;&#xA;    If finalLTR.Contains(&quot;실패&quot;) Then&#xD;&#xA;        io_IsSuccess = &quot;False&quot;&#xD;&#xA;        hasError = True&#xD;&#xA;    Else&#xD;&#xA;        io_IsSuccess = &quot;True&quot;&#xD;&#xA;        hasError = False&#xD;&#xA;    End If&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;' 7. TẠO BẢNG HTML 6 CỘT CHUẨN ĐÚNG REQUIREMENT&#xD;&#xA;Dim html As New System.Text.StringBuilder()&#xD;&#xA;html.Append(&quot;&lt;table style='width: 100%; border-collapse: collapse; margin-top: 15px; font-family: 맑은 고딕, Arial, sans-serif; border: 1px solid #b0b0b0;'&gt;&quot;)&#xD;&#xA;html.Append(&quot;&lt;tr style='background-color: #003087; color: white; text-align: center;'&gt;&quot;)&#xD;&#xA;html.Append(&quot;&lt;th style='padding: 10px; border: 1px solid #002266; width: 16%;'&gt;구분&lt;/th&gt;&quot;)&#xD;&#xA;html.Append(&quot;&lt;th style='padding: 10px; border: 1px solid #002266; width: 17%;'&gt;조회결과&lt;/th&gt;&quot;)&#xD;&#xA;html.Append(&quot;&lt;th style='padding: 10px; border: 1px solid #002266; width: 16%;'&gt;다운로드&lt;/th&gt;&quot;)&#xD;&#xA;html.Append(&quot;&lt;th style='padding: 10px; border: 1px solid #002266; width: 17%;'&gt;데이터 편집&lt;/th&gt;&quot;)&#xD;&#xA;html.Append(&quot;&lt;th style='padding: 10px; border: 1px solid #002266; width: 18%;'&gt;M.Post 업로드&lt;/th&gt;&quot;)&#xD;&#xA;html.Append(&quot;&lt;th style='padding: 10px; border: 1px solid #002266; width: 16%;'&gt;최종결과&lt;/th&gt;&quot;)&#xD;&#xA;html.Append(&quot;&lt;/tr&gt;&quot;)&#xD;&#xA;&#xD;&#xA;If multiLine.Contains(compCode.ToUpper()) Then&#xD;&#xA;    ' Hàng 장기&#xD;&#xA;    html.Append($&quot;&lt;tr style='text-align: center;'&gt;&lt;td style='padding: 10px; font-weight: bold; 