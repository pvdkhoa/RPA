center;'&gt;&lt;td style='padding: 10px; font-weight: bold; border: 1px solid #c8c8c8; background-color: #f8f9fa;'&gt;단일계약&lt;/td&gt;&lt;td style='padding: 10px; border: 1px solid #c8c8c8;'&gt;{formatSearch(sLTR, dLTR)}&lt;/td&gt;&lt;td style='padding: 10px; border: 1px solid #c8c8c8;'&gt;{formatStep(dLTR)}&lt;/td&gt;&lt;td style='padding: 10px; border: 1px solid #c8c8c8;'&gt;{formatStep(mLTR)}&lt;/td&gt;&lt;td style='padding: 10px; border: 1px solid #c8c8c8;'&gt;{formatStep(uploadLTR)}&lt;/td&gt;&lt;td style='padding: 10px; border: 1px solid #c8c8c8;'&gt;{finalLTR}&lt;/td&gt;&lt;/tr&gt;&quot;)&#xD;&#xA;End If&#xD;&#xA;html.Append(&quot;&lt;/table&gt;&quot;)&#xD;&#xA;out_TableHtml = html.ToString()&#xD;&#xA;&#xD;&#xA;' 8. Khung chẩn đoán AI màu vàng (chỉ hiện khi có lỗi thực tế)&#xD;&#xA;If hasError Then&#xD;&#xA;    Dim errBox As New System.Text.StringBuilder()&#xD;&#xA;    errBox.Append(&quot;&lt;div style='background-color: #fff3cd; border-left: 5px solid #ffc107; padding: 15px; margin-top: 15px; font-family: 맑은 고딕, Arial, sans-serif;'&gt;&quot;)&#xD;&#xA;    errBox.Append(&quot;&lt;h4 style='color: #856404; margin: 0 0 10px 0;'&gt;⚠️ 업로드 오류 상세 안내&lt;/h4&gt;&quot;)&#xD;&#xA;    &#xD;&#xA;    If Not String.IsNullOrWhiteSpace(failedBranch) OrElse Not String.IsNullOrWhiteSpace(failedStep) Then&#xD;&#xA;        errBox.Append($&quot;&lt;p style='margin: 5px 0;'&gt;&lt;b&gt;실패 구분/단계:&lt;/b&gt; {failedBranch} {If(Not String.IsNullOrWhiteSpace(failedStep), $&quot;({failedStep})&quot;, &quot;&quot;)}&lt;/p&gt;&quot;)&#xD;&#xA;    End If&#xD;&#xA;    &#xD;&#xA;    errBox.Append($&quot;&lt;p style='margin: 5px 0;'&gt;&lt;b&gt;화면 팝업 메시지:&lt;/b&gt; {If(String.IsNullOrEmpty(errorPopup), &quot;확인된 팝업 없음&quot;, errorPopup)}&lt;/p&gt;&quot;)&#xD;&#xA;    errBox.Append($&quot;&lt;p style='margin: 5px 0;'&gt;&lt;b&gt;오류 원인:&lt;/b&gt; {If(String.IsNullOrEmpty(aiAnalysis), &quot;AI 업로드 처리 중 오류 발생&quot;, aiAnalysis)}&lt;/p&gt;&quot;)&#xD;&#xA;    errBox.Append($&quot;&lt;p style='margin: 5px 0;'&gt;&lt;b&gt;확인 및 조치 사항:&lt;/b&gt; {If(String.IsNullOrEmpty(aiSuggestion), &quot;OpenGA 포털 화면 및 업로드 데이터를 확인하십시오.&quot;, aiSuggestion)}&lt;/p&gt;&quot;)&#xD;&#xA;    errBox.Append(&quot;&lt;/div&gt;&quot;)&#xD;&#xA;    out_AIBoxHtml = errBox.ToString()&#xD;&#xA;Else&#xD;&#xA;    out_AIBoxHtml = &quot;&quot;&#xD;&#xA;End If&#xD;&#xA;" DisplayName="Invoke Code -  Parse AI Result" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_4">
